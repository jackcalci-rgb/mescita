# Lascia ODOO_URL vuoto per la modalità demo (magazzino finto)
ODOO_URL=https://tuaazienda.odoo.com
ODOO_DB=tuaazienda
ODOO_USER=mescita@osteriadvor.com
# Odoo > Preferenze utente > Sicurezza account > Nuova chiave API
ODOO_API_KEY=
# Opzionali: ID posizione magazzino e categorie prodotti vino (separate da virgola,
# categorie prodotto o categorie POS, es. ODOO_WINE_CATEGORY=Vini Bianchi,Vini Rossi,Bollicine)
ODOO_LOCATION_ID=
ODOO_WINE_CATEGORY=Vini
# Categoria dei prodotti calice venduti al POS (per gli abbinamenti)
ODOO_CALICE_CATEGORY=Mescita
# Attributo del calice con il nome del produttore (prende anche "Produttore Classico"/"Produttore Charmat")
ODOO_ATTRIBUTO_PRODUTTORE=Produttore
# Password iniziale dell'utente admin (usata solo al primo avvio)
MESCITA_PASSWORD=
# Avviso apertura bottiglie con costo Odoo superiore a (euro)
MESCITA_SOGLIA_PREZZO=45
# Token che il sito osteriadvor.com usa per leggere la disponibilita' dei vini (carta vini). Lungo e casuale, per esempio: openssl rand -hex 24
MESCITA_SITE_TOKEN=
